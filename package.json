{
  "name": "uguroezdamar.com",
  "version": "1.0.0",
  "description": "The official website of Ugur Özdamar",
  "private": true,
  "packageManager": "pnpm@10.34.2",
  "engines": {
    "node": ">=24 <25"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "pnpm ugur dev",
    "dev:site": "pnpm ugur dev --filter site",
    "dev:portal": "pnpm ugur dev --filter portal",
    "guard:legacy-imports": "node ./tooling/guards/legacy-imports.mjs",
    "guard:no-feature-server-imports": "node ./tooling/guards/no-feature-server-imports.mjs",
    "guard:no-deep-imports": "node ./tooling/guards/no-deep-imports.mjs",
    "guard:no-next-in-server": "node ./tooling/guards/no-next-in-server.mjs",
    "guard": "pnpm guard:legacy-imports && pnpm guard:no-feature-server-imports && pnpm guard:no-deep-imports && pnpm guard:no-next-in-server",
    "check:no-legacy-ui": "pnpm guard:legacy-imports",
    "build": "pnpm guard && turbo build",
    "build:site": "pnpm guard && turbo run build --filter=@ugur/site",
    "lint": "pnpm guard && turbo lint && eslint tooling --ext .mjs",
    "typecheck": "pnpm guard && turbo typecheck",
    "test": "pnpm guard && turbo run build --filter=@ugur/server --filter=@ugur/core && vitest run",
    "check": "pnpm lint && pnpm db:check && pnpm typecheck && pnpm test",
    "clean": "turbo clean",
    "ui:add": "pnpm dlx shadcn@latest add -c packages/ui",
    "ui:diff": "pnpm dlx shadcn@latest diff -c packages/ui",
    "start": "pnpm --filter @ugur/site start",
    "db:generate": "pnpm ugur db generate",
    "db:check": "pnpm ugur db check",
    "db:migrate": "pnpm ugur db migrate",
    "db:studio": "pnpm ugur db studio",
    "ugur": "node tooling/cli/src/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devUgur/uguroezdamar.com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/devUgur/uguroezdamar.com/issues"
  },
  "homepage": "https://github.com/devUgur/uguroezdamar.com#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@ugur/ui": "workspace:*",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.575.0",
    "next": "^16.4.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@next/eslint-plugin-next": "16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gray-matter": "4.0.3",
    "postcss": "^8.5.29",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "^5.0.4",
    "yaml": "2.9.1"
  }
}
