{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "eslint.config.mjs"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_DIRECT",
    "APP_URL",
    "CONTACT_RATE_LIMIT_SECRET",
    "ADMIN_API_KEY",
    "ADMIN_SESSION_TTL_SECONDS",
    "ADMIN_INVITE_EXPIRES_HOURS",
    "VERCEL_BYPASS_SITE",
    "VERCEL_BYPASS_PORTAL"
  ],
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "build": {
      "dependsOn": [
        "transit"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "NEXT_PUBLIC_SITE_URL",
        "VERCEL_ENV",
        "VERCEL_URL",
        "VERCEL_GIT_COMMIT_SHA"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
