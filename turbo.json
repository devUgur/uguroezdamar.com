{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_DIRECT",
    "APP_URL",
    "SITE_URL",
    "CONTACT_RATE_LIMIT_SECRET",
    "ADMIN_API_KEY",
    "REVALIDATE_SECRET",
    "ADMIN_SESSION_TTL_SECONDS",
    "ADMIN_INVITE_EXPIRES_HOURS",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "R2_PUBLIC_BASE_URL",
    "R2_ENDPOINT",
    "R2_REGION",
    "R2_FORCE_PATH_STYLE",
    "PREVIEW_USE_STORAGE",
    "SCREENSHOT_PROVIDER_URL",
    "SCREENSHOT_API_KEY"
  ],
  "tasks": {
    "guard": {
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "guard",
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "out/**"
      ],
      "env": [
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "guard"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "guard"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
