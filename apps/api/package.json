{
  "name": "@ugur/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply uguroezdamar --remote && wrangler deploy",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "types": "wrangler types --env-interface CloudflareEnv src/worker-configuration.d.ts",
    "clean": "rimraf dist .wrangler"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.45.0"
  }
}
