# Public canonical URL used for the sitemap and absolute metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for public CMS content (projects, career and profile) in production.
MONGODB_URI=

# Required in production for the contact endpoint's MongoDB-backed rate limit.
# Generate a random secret with at least 32 characters and use separate values per environment.
CONTACT_RATE_LIMIT_SECRET=

# Optional secret for controlled preview/revalidation integrations.
REVALIDATE_SECRET=
